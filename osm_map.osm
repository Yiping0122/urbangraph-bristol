 <node id="2268838297" visible="true" version="4" changeset="187889852" timestamp="2026-08-23T14:09:42Z" user="mueschel" uid="616774" lat="51.4547716" lon="-2.5935487">
  <tag k="board_type" v="board"/>
  <tag k="direction" v="150"/>
  <tag k="historic" v="memorial"/>
  <tag k="inscription:1" v="On this site stood The Bush, a celebrated coaching inn. Edmund Burke M.P. used it as his election campaign headquarters. In Pickwick Papers, Charles Dickens had Mr. Winkle stay there."/>
  <tag k="inscription:2" v="The inn later became Bush Chambers, where Bristol &amp; West Building Society was founded in 1850. The present building was erected in 1857 by The West of England and South Wales District Bank."/>
  <tag k="inscription:3" v="The Architects, W. B. Gingell and T. R. Lysaght, based its High Renaissance style on Jacopo Sansovino’s Library of St. Mark, Venice. It has been occupied by Lloyds Bank Limited since 1892 and the exterior remains substantially in its original form."/>
  <tag k="memorial" v="plaque"/>
  <tag k="name" v="The Bush Coaching Inn"/>
  <tag k="openplaques:id" v="41339"/>
 </node>

  <tag k="description" v="Rivers linked by a canal. The name refers to the entire navigable length. From Bristol the way is the Avon. The canal is from Bath to Newbury. From there to Reading the way is the Kennet. 53 locks to Summit Pound (150 m asl) and 54 down to Reading."/>
  <tag k="distance" v="140 km"/>
  <tag k="from" v="River Avon at Bristol"/>
  <tag k="name" v="Kennet and Avon Canal Trail"/>
  <tag k="network" v="rwn"/>
  <tag k="operator" v="Canal River Trust"/>
  <tag k="ref" v="K&amp;A"/>
  <tag k="route" v="hiking"/>
  <tag k="to" v="River Thames at Reading"/>
  <tag k="type" v="route"/>
  <tag k="via" v="Bath;Bradford on Avon;Devizes;Hungerford;Thatcham"/>
  <tag k="website" v="https://canalrivertrust.org.uk/enjoy-the-waterways/canal-and-river-network/kennet-and-avon-canal"/>
  <tag k="wikidata" v="Q1412795"/>
  <tag k="wikipedia" v="en:Kennet and Avon Canal"/>
 </relation>

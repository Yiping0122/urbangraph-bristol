  <tag k="board_type" v="history"/>
  <tag k="check_date" v="2022-09-25"/>
  <tag k="direction" v="155"/>
  <tag k="historic" v="memorial"/>
  <tag k="inscription:1" v="Spanish Civil War 1936‒39. This plaque was erected by Bristol City Council to commemorate those British volunteers who fought with the Republican Army in the Spanish Civil War. The 526 volunteers from Britain who gave their lives in the fight to defend"/>
  <tag k="inscription:2" v="democracy included 4 men from Bristol. They died for Liberty. W. G. Boyce, January 1938. J. Burton, February 1937. L. Huson, May 1938. T. E. Stephens, July 1938. This plaque was unveiled on 11th December 1986 by Mr. Jack Jones, C.H., General Secretary of"/>
  <tag k="inscription:3" v="the T.G.W.U. 1969 to 1978 and member of the International Brigade."/>
  <tag k="material" v="metal"/>
  <tag k="memorial" v="plaque"/>
  <tag k="name" v="Spanish Civil War"/>
  <tag k="openplaques:id" v="88315"/>
  <tag k="start_date" v="1986-12-11"/>
 </node>
